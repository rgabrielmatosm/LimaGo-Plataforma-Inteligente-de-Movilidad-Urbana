# Opcional: sin .env, Docker usa estos mismos valores (todas las contraseñas = LimaGoPass).
# Para cambiarlos (PowerShell):  Copy-Item .env.example .env   y edita el archivo.
# LimaGoPass es una contraseña de demostración: cámbiala si expones el sitio fuera de tu equipo.
# IMPORTANTE (V3): si vienes de la V2, vuelve a copiar este archivo. Los valores LIMAGO_* que dejes
# definidos reemplazan a los del escenario; un .env de la V2 forzaría 300 conductores y turnos de 30 s.

# --- PostgreSQL ---
POSTGRES_DB=limago
POSTGRES_USER=limago
POSTGRES_PASSWORD=LimaGoPass

# --- Web ---
LIMAGO_PUERTO_WEB=8080

# --- Escenario (V3) ---
# lima       : aplicación comercial en Lima Metropolitana (2500 conductores, reloj de Lima, motor de aceptación)
# miraflores : escenario académico del informe (300 conductores, k=5, sin motor de aceptación)
LIMAGO_ESCENARIO=lima

# --- Ajustes opcionales: déjalos vacíos para usar los valores del escenario ---
LIMAGO_SEMILLA=42
LIMAGO_NUM_CONDUCTORES=
LIMAGO_K_CANDIDATOS=
LIMAGO_SOLICITUDES_POR_TURNO=
LIMAGO_SEGUNDOS_POR_TURNO=
LIMAGO_INTERVALO_REAL_TURNO_S=
# lima = sigue la hora local de Lima (America/Lima) | simulado = parte de LIMAGO_HORA_INICIO y avanza por turnos
LIMAGO_RELOJ=
LIMAGO_HORA_INICIO=
LIMAGO_CONGESTION_ACTIVA=
# Motor de aceptación: plazo de cada oferta (turnos) y probabilidad de aceptar de la política probabilística
LIMAGO_MOTOR_ACEPTACION=
LIMAGO_PLAZO_OFERTA_TURNOS=
LIMAGO_PROBABILIDAD_ACEPTACION=
LIMAGO_UNIDADES_APOYO=

# --- Tarifa en soles (vacío = valores por defecto: 3.50 + 1.10/km + 0.25/min, mínima 6.00) ---
LIMAGO_TARIFA_BASE=
LIMAGO_TARIFA_POR_KM=
LIMAGO_TARIFA_POR_MINUTO=
LIMAGO_TARIFA_MINIMA=

# --- Geocodificación (Nominatim de OpenStreetMap; máximo 1 petición por segundo) ---
LIMAGO_GEOCODIFICADOR_URL=https://nominatim.openstreetmap.org
LIMAGO_GEOCODIFICADOR_AGENTE=LimaGo-Proyecto-Academico/3.0

# --- Centro de operaciones ---
# Código de acceso para operaciones.html y /api/operaciones/*. Si se deja vacío, esas funciones quedan deshabilitadas.
LIMAGO_TOKEN_OPERACIONES=LimaGoPass

# --- Monitoreo: Grafana y Prometheus solo escuchan en 127.0.0.1 ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=LimaGoPass
LIMAGO_PUERTO_GRAFANA=3000
LIMAGO_PUERTO_PROMETHEUS=9090
