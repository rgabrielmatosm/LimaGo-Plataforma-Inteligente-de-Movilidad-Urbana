# Copia este archivo como .env y cambia la contraseña (PowerShell):  Copy-Item .env.example .env
# --- PostgreSQL ---
POSTGRES_DB=limago
POSTGRES_USER=limago
POSTGRES_PASSWORD=cambia-esta-contrasena

# --- Web ---
LIMAGO_PUERTO_WEB=8080

# --- Simulación (valores por defecto del informe) ---
LIMAGO_SEMILLA=42
LIMAGO_NUM_CONDUCTORES=300
LIMAGO_PROPORCION_OCUPADOS=0.2
LIMAGO_K_CANDIDATOS=5
LIMAGO_VELOCIDAD_KMH=25
LIMAGO_SEGUNDOS_POR_TURNO=30
LIMAGO_INTERVALO_REAL_TURNO_S=1.5
LIMAGO_SOLICITUDES_POR_TURNO=1.5
LIMAGO_HORA_INICIO=7.5
LIMAGO_CONGESTION_ACTIVA=false

# --- Quadtree ---
LIMAGO_CAPACIDAD_NODO=8
LIMAGO_PROFUNDIDAD_MAXIMA=18

# --- Geocodificación (Nominatim de OpenStreetMap; máximo 1 petición por segundo) ---
LIMAGO_GEOCODIFICADOR_URL=https://nominatim.openstreetmap.org
LIMAGO_GEOCODIFICADOR_AGENTE=LimaGo-Proyecto-Academico/1.0
